{
  "name": "react-aspnet-efcore-postgres",
  "description": "React + Vite + TypeScript frontend, ASP.NET Core (minimal APIs or controllers) + EF Core backend, PostgreSQL.",

  "exclude": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.{png,jpg,jpeg,gif,webp,ico,svg,avif,woff,woff2,ttf,eot,otf,mp4,webm,pdf,zip}",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/.gitignore",
    "**/.gitattributes",
    "**/.editorconfig",
    "**/.DS_Store"
  ],

  "layers": [
    { "id": "frontend", "label": "Frontend", "color": "#38bdf8", "description": "React app: routes, pages, components, hooks, API client" },
    { "id": "backend", "label": "Backend", "color": "#4ade80", "description": "ASP.NET Core: endpoints, services, DbContext, entities" },
    { "id": "database", "label": "Database", "color": "#fb923c", "description": "PostgreSQL schema from the EF Core model: tables, columns, foreign keys, migrations" },
    { "id": "infra", "label": "Infra & tooling", "color": "#a78bfa", "description": "CI, containers, scripts and docs" }
  ],
  "layerRules": [
    { "match": ["**/Migrations/**"], "layer": "database", "reason": "EF Core migrations folder" },
    { "marker": "package.json", "contains": "\"react\"", "layer": "frontend", "reason": "inside a package.json that depends on React" },
    { "marker": "*.csproj", "layer": "backend", "reason": "inside a .NET project" },
    { "match": ["**/*.sln", "**/*.slnx", "**/global.json", "**/Directory.Build.*", "**/Directory.Packages.props", "**/nuget.config"], "layer": "backend", "reason": ".NET solution file" }
  ],
  "defaultLayer": "infra",

  "roles": [
    { "id": "production", "label": "Production", "color": "#e2e8f0", "description": "Code that ships" },
    { "id": "test", "label": "Tests", "color": "#fb7185" },
    { "id": "test/unit", "label": "Unit", "color": "#fb7185", "parent": "test" },
    { "id": "test/integration", "label": "Integration", "color": "#f472b6", "parent": "test" },
    { "id": "test/e2e", "label": "End-to-end", "color": "#e879f9", "parent": "test" },
    { "id": "test/support", "label": "Test support", "color": "#fda4af", "parent": "test", "description": "Fixtures, mock servers and helpers used only by tests" },
    { "id": "config", "label": "Config", "color": "#94a3b8" },
    { "id": "migration", "label": "Migrations", "color": "#c084fc" },
    { "id": "generated", "label": "Generated", "color": "#64748b" },
    { "id": "tooling", "label": "Tooling & CI", "color": "#a78bfa" },
    { "id": "docs", "label": "Docs", "color": "#cbd5e1" }
  ],
  "roleRules": [
    { "match": ["**/*.Designer.cs", "**/*.designer.cs", "**/*.g.cs", "**/*.g.i.cs", "**/*.generated.*", "**/*ModelSnapshot.cs", "**/__generated__/**", "**/*.gen.ts"], "role": "generated", "reason": "generated-file naming convention" },
    { "match": ["**/package.json", "**/tsconfig*.json", "**/jsconfig*.json", "**/*.config.{ts,mts,cts,js,mjs,cjs,json}", "**/.oxlintrc.json", "**/.eslintrc*", "**/.prettierrc*", "**/*.csproj", "**/*.sln", "**/*.slnx", "**/global.json", "**/Directory.Build.*", "**/Directory.Packages.props", "**/nuget.config", "**/appsettings*.json", "**/launchSettings.json", "**/docker-compose*.{yml,yaml}", "**/compose*.{yml,yaml}", "**/Dockerfile*", "**/.env.example", "**/.github/dependabot.yml"], "role": "config", "reason": "well-known config file" },
    { "match": ["**/Migrations/**", "**/migrations/**"], "role": "migration", "reason": "migrations folder" },
    { "match": ["**/e2e/**", "**/*.e2e.*", "**/*.e2e-spec.*", "**/cypress/**", "**/playwright/**"], "role": "test/e2e", "reason": "end-to-end test location" },
    { "match": ["**/*IntegrationTests*/**", "**/integration-tests/**", "**/*.integration.test.*", "**/*.int.test.*"], "role": "test/integration", "reason": "integration test location" },
    { "match": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/*UnitTests*/**", "**/*.Tests/**", "**/*Tests.cs"], "role": "test/unit", "reason": "test file naming convention" },
    { "match": ["**/test/**", "**/tests/**", "**/__mocks__/**", "**/testing/**", "**/*TestUtils*"], "role": "test/support", "reason": "test support folder" },
    { "match": [".github/**", "scripts/**", "tools/**", "**/*.http", "**/Makefile", "**/*.sh", "**/*.ps1"], "role": "tooling", "reason": "tooling / CI location" },
    { "match": ["**/*.md", "**/*.mdx", "docs/**", "**/LICENSE*"], "role": "docs", "reason": "documentation" }
  ],
  "defaultRole": "production",

  "kinds": [
    { "id": "route", "label": "Route", "color": "#7dd3fc", "description": "A frontend URL route" },
    { "id": "page", "label": "Page", "color": "#38bdf8", "description": "A component rendered by a route" },
    { "id": "component", "label": "Component", "color": "#60a5fa" },
    { "id": "provider", "label": "Provider", "color": "#818cf8", "description": "A component that provides a React context" },
    { "id": "hook", "label": "Hook", "color": "#a78bfa" },
    { "id": "context", "label": "Context", "color": "#c084fc" },
    { "id": "api-client", "label": "API client", "color": "#22d3ee", "description": "The object/module every backend call goes through" },
    { "id": "api-call", "label": "API call", "color": "#2dd4bf", "description": "A client function that calls a backend endpoint" },
    { "id": "store-api", "label": "Query API", "color": "#67e8f9", "description": "An RTK Query API (createApi / injectEndpoints); its generated hooks hang under it" },
    { "id": "slice", "label": "Store slice", "color": "#f472b6", "description": "A Redux slice (createSlice): a part of the app state and its reducers" },
    { "id": "action", "label": "Action", "color": "#f9a8d4", "description": "A Redux action a slice defines" },
    { "id": "thunk", "label": "Thunk", "color": "#e879f9", "description": "An async Redux action (createAsyncThunk)" },
    { "id": "function", "label": "Function", "color": "#93c5fd" },
    { "id": "constant", "label": "Constant", "color": "#fde047", "description": "An exported table of values: the site's strings, its tabs, labels by key" },
    { "id": "class", "label": "Class", "color": "#cbd5e1" },
    { "id": "type", "label": "Type", "color": "#94a3b8" },
    { "id": "interface", "label": "Interface", "color": "#a5b4fc" },
    { "id": "entrypoint", "label": "Entry point", "color": "#f1f5f9", "description": "Where the app starts (main.tsx, Program.cs)" },
    { "id": "stylesheet", "label": "Stylesheet", "color": "#f9a8d4" },
    { "id": "html", "label": "HTML page", "color": "#fdba74" },

    { "id": "endpoint", "label": "Endpoint", "color": "#4ade80", "description": "An HTTP route the API serves" },
    { "id": "endpoint-slice", "label": "Endpoint slice", "color": "#4ade80", "description": "A vertical slice: one endpoint with its route, request, response and handler (an IEndpoint the app finds by itself)" },
    { "id": "endpoint-group", "label": "Endpoint group", "color": "#86efac", "description": "A class that maps a feature's endpoints" },
    { "id": "controller", "label": "Controller", "color": "#86efac" },
    { "id": "service", "label": "Service", "color": "#34d399" },
    { "id": "middleware", "label": "Middleware", "color": "#5eead4", "description": "Request pipeline middleware, or a Redux listener middleware" },
    { "id": "options", "label": "Options", "color": "#a3e635", "description": "A class bound to a configuration section" },
    { "id": "dto", "label": "DTO", "color": "#bef264", "description": "A request/response contract" },
    { "id": "setup", "label": "Setup / DI", "color": "#6ee7b7", "description": "Service registration and app configuration" },
    { "id": "dbcontext", "label": "DbContext", "color": "#facc15" },
    { "id": "entity", "label": "Entity", "color": "#fbbf24" },
    { "id": "property", "label": "Property", "color": "#fde68a" },
    { "id": "enum", "label": "Enum", "color": "#a1a1aa" },

    { "id": "table", "label": "Table", "color": "#fb923c" },
    { "id": "column", "label": "Column", "color": "#fdba74" },
    { "id": "migration", "label": "Migration", "color": "#c084fc" },
    { "id": "snapshot", "label": "Model snapshot", "color": "#a78bfa" },

    { "id": "test-suite", "label": "Test suite", "color": "#fb7185" },
    { "id": "test-helper", "label": "Test helper", "color": "#fda4af", "description": "Fixture, mock server or render helper" },

    { "id": "project", "label": "Project file", "color": "#cbd5e1" },
    { "id": "config-file", "label": "Config file", "color": "#94a3b8" },
    { "id": "workflow", "label": "CI workflow", "color": "#c4b5fd" },
    { "id": "script", "label": "Script", "color": "#d6d3d1" },
    { "id": "http-file", "label": "HTTP requests", "color": "#5eead4" },
    { "id": "doc", "label": "Document", "color": "#e2e8f0" },
    { "id": "file", "label": "File", "color": "#9ca3af" }
  ],

  "edgeTypes": [
    { "id": "contains", "label": "Contains", "color": "#64748b", "description": "Parent → child (class → member, table → column)" },
    { "id": "renders", "label": "Renders", "color": "#60a5fa" },
    { "id": "uses", "label": "Uses", "color": "#94a3b8" },
    { "id": "provides", "label": "Provides", "color": "#818cf8", "description": "Provider → context" },
    { "id": "calls", "label": "Calls", "color": "#22d3ee" },
    { "id": "http", "label": "HTTP", "color": "#2dd4bf", "description": "Client call → backend endpoint" },
    { "id": "navigates", "label": "Navigates", "color": "#7dd3fc", "description": "Link/redirect to a route" },
    { "id": "injects", "label": "Injects", "color": "#34d399", "description": "Dependency injection" },
    { "id": "resolves", "label": "Resolves", "color": "#6ee7b7", "description": "Service locator (GetRequiredService<T>)" },
    { "id": "queries", "label": "Queries", "color": "#fbbf24", "description": "Uses an entity's DbSet" },
    { "id": "exposes", "label": "Exposes", "color": "#facc15", "description": "DbContext → entity set (DbSet<T>); not followed by traces, which use the precise queries/reads/writes instead" },
    { "id": "reads", "label": "Reads", "color": "#fcd34d", "description": "Reads an entity property" },
    { "id": "writes", "label": "Writes", "color": "#f97316", "description": "Assigns an entity property" },
    { "id": "returns", "label": "Returns", "color": "#bef264" },
    { "id": "maps-to", "label": "Maps to", "color": "#fb923c", "description": "Entity → table, property → column" },
    { "id": "foreign-key", "label": "Foreign key", "color": "#fdba74" },
    { "id": "registers", "label": "Registers", "color": "#a3e635", "description": "DI registration" },
    { "id": "uses-type", "label": "Uses type", "color": "#64748b" },
    { "id": "mirrors", "label": "Mirrors", "color": "#e879f9", "description": "Frontend type ↔ backend DTO" },
    { "id": "tests", "label": "Tests", "color": "#fb7185" },
    { "id": "mocks", "label": "Mocks", "color": "#fda4af", "description": "Test double of an endpoint (MSW, page.route)" },
    { "id": "migrates", "label": "Migrates", "color": "#c084fc", "description": "Migration → table/column it changes" },
    { "id": "configures", "label": "Configures", "color": "#94a3b8" },
    { "id": "depends-on", "label": "Depends on", "color": "#cbd5e1", "description": "Project reference" }
  ],


  "plugins": [
    {
      "id": "dotnet",
      "label": ".NET code (Roslyn)",
      "kind": "extractor",
      "source": "plugins/extract-dotnet",
      "requires": ["dotnet"],
      "build": ["dotnet", "build", "plugins/extract-dotnet/RepoMap.DotNet.csproj", "-c", "Release", "-nologo", "-v", "q"],
      "command": ["dotnet", "plugins/extract-dotnet/bin/Release/net10.0/RepoMap.DotNet.dll", "code"],
      "include": ["**/*.cs", "**/*.csproj", "**/*.sln", "**/*.slnx", "**/appsettings*.json"],
      "layers": ["backend", "database"]
    },
    {
      "id": "efcore",
      "label": "EF Core model & migrations",
      "kind": "extractor",
      "source": "plugins/extract-dotnet",
      "requires": ["dotnet"],
      "build": ["dotnet", "build", "plugins/extract-dotnet/RepoMap.DotNet.csproj", "-c", "Release", "-nologo", "-v", "q"],
      "command": ["dotnet", "plugins/extract-dotnet/bin/Release/net10.0/RepoMap.DotNet.dll", "efcore"],
      "include": ["**/*.cs"],
      "layers": ["backend", "database"],
      "options": { "defaultSchema": "public" }
    },
    {
      "id": "typescript",
      "label": "TypeScript / React (ts-morph)",
      "kind": "extractor",
      "source": "plugins/extract-ts",
      "command": ["node", "plugins/extract-ts/main.ts"],
      "include": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "layers": ["frontend"],
      "options": { "apiPrefixes": ["/api"] }
    },
    {
      "id": "files",
      "label": "Files (generic)",
      "kind": "extractor",
      "source": "plugins/extract-files",
      "command": ["node", "plugins/extract-files/main.ts"],
      "include": ["**/*"]
    },
    {
      "id": "http",
      "label": "HTTP & navigation links",
      "kind": "linker",
      "source": "plugins/link-http",
      "command": ["node", "plugins/link-http/main.ts"]
    },
    {
      "id": "contracts",
      "label": "Contract mirrors",
      "kind": "linker",
      "source": "plugins/link-contracts",
      "command": ["node", "plugins/link-contracts/main.ts"]
    }
  ]
}

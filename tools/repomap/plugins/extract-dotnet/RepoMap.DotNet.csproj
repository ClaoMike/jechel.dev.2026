<Project Sdk="Microsoft.NET.Sdk">

  <!--
    repomap plugin for .NET: a console app that reads a PluginRequest (JSON) on stdin and prints a
    PluginOutput (JSON) on stdout.
      dotnet RepoMap.DotNet.dll code    Roslyn semantic analysis of C# projects (endpoints, services, DI, tests…)
      dotnet RepoMap.DotNet.dll efcore  EF Core model snapshot + migrations → tables, columns, foreign keys
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RepoMap.DotNet</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

</Project>

{
  "extends": "./presets/react-aspnet-efcore-postgres.json",
  "name": "jechel.dev.2026",
  "repoRoot": "../..",
  "output": ".out/graph.json",
  "exclude": ["tools/repomap/**"],

  // The frontend as two planes: the components on top, then the store (Redux, RTK Query, the API service) and
  // everything else under them. They're laid out together as one tree from main.tsx.
  "layers": [
    { "id": "frontend-views", "label": "Frontend · Components", "color": "#38bdf8", "before": "frontend", "arrange": "tree", "description": "Components (*.tsx): main.tsx, App, pages and components, with their state, effects and store access" },
    { "id": "frontend", "label": "Frontend · Store & the rest", "color": "#22d3ee", "gap": 50, "arrange": "tree", "description": "Redux store (slices, thunks, listeners), RTK Query endpoints, the API service, shared hooks, utilities and config" }
  ],
  "layerRules": [
    { "match": ["frontend/src/**/*.tsx"], "layer": "frontend-views", "reason": "a component" }
  ],

  "plugins": [{ "id": "typescript", "layers": ["frontend-views", "frontend"] }],

  // The Board tab: the three frontend planes are one tier; features come from frontend/src/features/* and
  // backend Features/* (folder names lowercased: workWithMe → workwithme).
  "board": {
    "tiers": [
      { "id": "frontend", "label": "Frontend", "color": "#38bdf8", "layers": ["frontend-views", "frontend-viewmodels", "frontend"], "description": "React + Vite app: views, view models, the Redux store and the API service" },
      { "id": "backend", "label": "Backend", "color": "#4ade80", "layers": ["backend"], "description": "ASP.NET Core minimal API: endpoints, services, EF Core" },
      { "id": "database", "label": "Database", "color": "#fb923c", "layers": ["database"], "description": "PostgreSQL: tables and columns from the EF Core model" },
      { "id": "infra", "label": "Infra & tooling", "color": "#a78bfa", "layers": ["infra"] }
    ],
    "featureLabels": {
      "about": "About Me",
      "workwithme": "Work with me",
      "whatsnew": "What's new",
      "youtube": "YouTube",
      "leetcode": "LeetCode",
      "featuretesting": "Feature Testing",
      "site": "Site"
    },
    "featureAliases": {},
    "featureOverrides": {}
  },

  // Checked on every build: the Board marks the edges that break them, `npm run check` lists them.
  "rules": [
    {
      "id": "views-use-their-view-model",
      "description": "MVVM: a view reaches the store and the API only through its view model",
      "severity": "warn",
      "from": { "layers": ["frontend-views"], "roles": ["production"] },
      "to": { "kinds": ["slice", "thunk", "store-api", "api-client", "api-call"] },
      "edgeTypes": ["uses", "calls"],
      "deny": true
    },
    {
      "id": "frontend-calls-its-own-feature",
      "description": "A feature's frontend calls only its own feature's endpoints (shared, auth and site may be called from anywhere)",
      "severity": "warn",
      "from": { "tiers": ["frontend"], "roles": ["production"] },
      "to": { "tiers": ["backend"] },
      "edgeTypes": ["http"],
      "sameFeature": true,
      "allowFeatures": ["auth", "site"]
    },
    {
      "id": "features-dont-share-tables",
      "description": "Only a feature's own backend reads or writes its tables' entities",
      "severity": "warn",
      "from": { "tiers": ["backend"], "roles": ["production"] },
      "to": { "kinds": ["entity", "property"] },
      "edgeTypes": ["queries", "writes"],
      "sameFeature": true
    }
  ],

  "presets": [
    {
      "id": "data",
      "filter": {
        "layers": { "frontend-views": "hide", "frontend": "hide", "infra": "hide" },
        "kinds": { "*": "dim", "dbcontext": "show", "entity": "show", "property": "show", "table": "show", "column": "show", "migration": "show", "snapshot": "show" },
        "roles": { "test": "hide", "config": "hide", "tooling": "hide", "docs": "hide" }
      }
    }
  ]
}

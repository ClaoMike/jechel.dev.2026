{
  "extends": "./presets/react-aspnet-efcore-postgres.json",
  "name": "jechel.dev.2026",
  "repoRoot": "../..",
  "output": ".out/graph.json",
  "exclude": ["tools/repomap/**"],

  // The frontend is MVVM (README → State and caching): views on top, their view models under them,
  // then the Model (Redux store, RTK Query, the API service) and everything else. The three planes are
  // laid out together as one tree from main.tsx.
  "layers": [
    { "id": "frontend-views", "label": "Frontend · Views", "color": "#38bdf8", "before": "frontend", "arrange": "tree", "description": "Views (*.tsx): main.tsx, App, pages and components; they render and call their own view model" },
    { "id": "frontend-viewmodels", "label": "Frontend · View models", "color": "#818cf8", "before": "frontend", "gap": 50, "arrange": "tree", "description": "View models (*.viewModel.ts): a view's state, effects, store access and commands" },
    { "id": "frontend", "label": "Frontend · Model & the rest", "color": "#22d3ee", "gap": 50, "arrange": "tree", "description": "Redux store (slices, thunks, listeners), RTK Query endpoints, the API service, utilities and config" }
  ],
  "layerRules": [
    { "match": ["frontend/src/**/*.viewModel.ts"], "layer": "frontend-viewmodels", "reason": "a view model (MVVM)" },
    { "match": ["frontend/src/**/*.tsx"], "layer": "frontend-views", "reason": "a view (MVVM)" }
  ],

  "plugins": [{ "id": "typescript", "layers": ["frontend-views", "frontend-viewmodels", "frontend"] }],

  "presets": [
    {
      "id": "data",
      "filter": {
        "layers": { "frontend-views": "hide", "frontend-viewmodels": "hide", "frontend": "hide", "infra": "hide" },
        "kinds": { "*": "dim", "dbcontext": "show", "entity": "show", "property": "show", "table": "show", "column": "show", "migration": "show", "snapshot": "show" },
        "roles": { "test": "hide", "config": "hide", "tooling": "hide", "docs": "hide" }
      }
    }
  ]
}

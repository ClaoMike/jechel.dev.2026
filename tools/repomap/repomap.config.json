{
  "extends": "./presets/react-aspnet-efcore-postgres.json",
  "name": "jechel.dev.2026",
  "repoRoot": "../..",
  "output": ".out/graph.json",
  "exclude": ["tools/repomap/**"],

  // The frontend as two planes: the components on top, then the store (Redux, RTK Query, the API service) and
  // everything else under them. They're laid out together as one tree from main.tsx.
  "layers": [
    { "id": "frontend-views", "label": "Frontend · Components", "color": "#38bdf8", "before": "frontend", "arrange": "tree", "description": "Components (*.tsx): main.tsx, App, pages and components, with their state, effects and store access" },
    { "id": "frontend", "label": "Frontend · Store & the rest", "color": "#22d3ee", "gap": 50, "arrange": "tree", "description": "Redux store (slices, thunks, listeners), RTK Query endpoints, the API service, shared hooks, utilities and config" }
  ],
  "layerRules": [
    { "match": ["frontend/src/**/*.tsx"], "layer": "frontend-views", "reason": "a component" }
  ],

  "plugins": [{ "id": "typescript", "layers": ["frontend-views", "frontend"] }],

  "presets": [
    {
      "id": "data",
      "filter": {
        "layers": { "frontend-views": "hide", "frontend": "hide", "infra": "hide" },
        "kinds": { "*": "dim", "dbcontext": "show", "entity": "show", "property": "show", "table": "show", "column": "show", "migration": "show", "snapshot": "show" },
        "roles": { "test": "hide", "config": "hide", "tooling": "hide", "docs": "hide" }
      }
    }
  ]
}

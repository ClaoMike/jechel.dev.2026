{
  // Node side: CLI, plugins, samples, tests. Runs directly with Node's type stripping (no build step),
  // so only erasable TypeScript syntax is allowed and relative imports use the .ts extension.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "plugins", "samples", "test", "e2e", "playwright.config.ts", "viewer/vite.config.ts"],
  "exclude": ["plugins/extract-dotnet"]
}

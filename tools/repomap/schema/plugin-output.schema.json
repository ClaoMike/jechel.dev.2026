{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "repomap/plugin-output.schema.json",
  "title": "repomap plugin output",
  "description": "What an extractor or linker prints to stdout. Layer/role/source/confidence may be omitted; the builder fills them in.",
  "type": "object",
  "required": ["protocol"],
  "properties": {
    "protocol": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[^:\\s]+:[^:\\s]+:.+$" },
          "label": { "type": "string" },
          "kind": { "type": "string", "minLength": 1 },
          "layer": { "type": "string" },
          "role": { "type": "string" },
          "parent": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "attrs": { "type": "object" },
          "description": { "type": "string" },
          "descriptionSource": { "enum": ["doc-comment", "llm", "manual", "derived"] },
          "roleReason": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "minLength": 1 },
          "source": { "enum": ["static", "llm", "manual"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file"],
              "properties": { "file": { "type": "string" }, "line": { "type": "integer" } }
            }
          },
          "attrs": { "type": "object" }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "edgeType"],
        "properties": {
          "type": { "enum": ["http", "navigate", "file-ref"] },
          "from": { "type": "string" },
          "edgeType": { "type": "string" },
          "method": { "type": "string" },
          "url": { "type": "string" },
          "path": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array" },
          "attrs": { "type": "object" }
        }
      }
    },
    "claims": { "type": "array", "items": { "type": "string" } },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "type", "target", "reason"],
        "properties": {
          "from": { "type": "string" },
          "type": { "type": "string" },
          "target": { "type": "string" },
          "reason": { "type": "string" },
          "evidence": { "type": "array" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "message"],
        "properties": {
          "level": { "enum": ["info", "warn", "error"] },
          "message": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    }
  }
}

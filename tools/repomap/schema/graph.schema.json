{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "repomap/graph.schema.json",
  "title": "repomap graph.json",
  "description": "Architecture graph of a repository. The viewer reads only this file.",
  "type": "object",
  "required": ["version", "meta", "nodes", "edges", "unresolved"],
  "properties": {
    "version": { "const": 1 },
    "meta": { "$ref": "#/definitions/meta" },
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/definitions/unresolved" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/diagnostic" } },
    "board": { "$ref": "#/definitions/board" }
  },
  "definitions": {
    "board": {
      "type": "object",
      "description": "The Board tab: tiers (groups of layers), features, AI summaries, architecture rules and their violations",
      "required": ["tiers", "features"],
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "color", "layers"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "type": "string" },
              "color": { "$ref": "#/definitions/color" },
              "layers": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "color"],
            "properties": { "id": { "$ref": "#/definitions/id" }, "label": { "type": "string" }, "color": { "$ref": "#/definitions/color" } }
          }
        },
        "summaries": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["text", "hash"],
            "properties": {
              "text": { "type": "string" },
              "hash": { "type": "string" },
              "model": { "type": "string" },
              "at": { "type": "string" },
              "stale": { "type": "boolean" }
            }
          }
        },
        "rules": { "type": "array", "items": { "type": "object", "required": ["id", "description"] } },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "severity", "from", "to", "type", "message"],
            "properties": {
              "rule": { "type": "string" },
              "severity": { "enum": ["error", "warn"] },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "type": { "type": "string" },
              "message": { "type": "string" },
              "evidence": { "$ref": "#/definitions/evidence" }
            }
          }
        }
      }
    },
    "id": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "visibility": { "enum": ["show", "dim", "hide"] },
    "visibilityMap": { "type": "object", "additionalProperties": { "$ref": "#/definitions/visibility" } },
    "evidence": {
      "type": "object",
      "required": ["file"],
      "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
    },
    "meta": {
      "type": "object",
      "required": ["tool", "repo", "generatedAt", "layers", "roles", "kinds", "edgeTypes", "presets"],
      "properties": {
        "tool": {
          "type": "object",
          "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "repo": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "root": { "type": "string" },
            "commit": { "type": "string" },
            "branch": { "type": "string" },
            "dirty": { "type": "boolean" }
          }
        },
        "generatedAt": { "type": "string" },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "color"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "type": "string" },
              "color": { "$ref": "#/definitions/color" },
              "flat": { "type": "boolean" },
              "gap": { "type": "number", "exclusiveMinimum": 0 },
              "arrange": { "enum": ["force", "tree"] },
              "description": { "type": "string" }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "color"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "type": "string" },
              "color": { "$ref": "#/definitions/color" },
              "parent": { "type": "string" },
              "style": { "enum": ["solid", "ghost"] },
              "planeOffset": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "color", "shape"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "type": "string" },
              "color": { "$ref": "#/definitions/color" },
              "shape": {
                "enum": ["sphere", "box", "octahedron", "cylinder", "cone", "torus", "tetrahedron", "dodecahedron", "icosahedron", "capsule", "tile", "disc"]
              },
              "size": { "type": "number", "exclusiveMinimum": 0 },
              "labelPriority": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "edgeTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "color"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "type": "string" },
              "color": { "$ref": "#/definitions/color" },
              "flow": { "type": "boolean" },
              "context": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "filter"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "filter": {
                "type": "object",
                "properties": {
                  "default": { "$ref": "#/definitions/visibility" },
                  "layers": { "$ref": "#/definitions/visibilityMap" },
                  "kinds": { "$ref": "#/definitions/visibilityMap" },
                  "roles": { "$ref": "#/definitions/visibilityMap" },
                  "edgeTypes": { "$ref": "#/definitions/visibilityMap" },
                  "sources": { "$ref": "#/definitions/visibilityMap" },
                  "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "kind", "layer", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^[^:\\s]+:[^:\\s]+:.+$" },
        "label": { "type": "string" },
        "kind": { "$ref": "#/definitions/id" },
        "layer": { "$ref": "#/definitions/id" },
        "role": { "$ref": "#/definitions/id" },
        "parent": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "attrs": { "type": "object" },
        "description": { "type": "string" },
        "descriptionSource": { "enum": ["doc-comment", "llm", "manual", "derived"] },
        "roleReason": { "type": "string" },
        "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "feature": { "type": "string" },
        "featureSource": { "enum": ["path", "manual", "llm", "derived", "shared"] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "type", "source", "confidence"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "$ref": "#/definitions/id" },
        "source": { "enum": ["static", "llm", "manual"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
        "attrs": { "type": "object" }
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["from", "type", "target", "reason"],
      "properties": {
        "from": { "type": "string" },
        "type": { "type": "string" },
        "target": { "type": "string" },
        "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["level", "message"],
      "properties": {
        "level": { "enum": ["info", "warn", "error"] },
        "message": { "type": "string" },
        "plugin": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" }
      }
    }
  }
}
